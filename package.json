{
  "name": "dsh-semantica-graph",
  "version": "1.0.0",
  "description": "DSH 插件：模型用 MCP 把当前对话写进 Semantica 知识图谱，面板内嵌上游 Knowledge Explorer 展示，并用插件自带的原生分析视图做分析",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "semantica",
    "knowledge-graph",
    "mcp",
    "explorer"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js && node --check src/kg.js && node --check src/explorer.js && node --check src/prompt.js && node --check src/session.js",
    "selftest": "node scripts/selftest.mjs",
    "visual": "node scripts/visual-check.mjs",
    "install": "node scripts/install.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
