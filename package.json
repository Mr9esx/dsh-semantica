{
  "name": "dsh-semantica-graph",
  "version": "0.10.0",
  "description": "DSH 插件：用 Semantica 把当前对话构建成知识图谱，在侧边栏内嵌其自带的 Knowledge Explorer 浏览，并可开新对话让 AI 分析",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "semantica",
    "knowledge-graph",
    "context-graph",
    "explorer"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js && node --check src/analyze.js && node scripts/check-inject.mjs",
    "check:endpoints": "node scripts/check-endpoints.mjs",
    "visual": "node scripts/visual-check.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
